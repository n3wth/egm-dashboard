# Template only. No real credentials belong in this file.
# UI development/build/tests require none of these values.
# For local Worker development, copy to egm-cloudflare/.dev.vars and fill only
# the keys needed. Wrangler loads .dev.vars; Vite does not consume this root file.
# Auth uses Secure cookies. A local auth test needs Wrangler HTTPS and a
# separately registered development callback, not production client changes.
APP_URL=https://localhost:8787
OWNER_EMAIL=oliver@newth.ai
# Keep collection disabled by default. An expired date prevents provider calls.
REFRESH_UNTIL=2000-01-01T00:00:00Z
SESSION_SECRET=
GITHUB_TOKEN=
# Use a separate development WorkOS application and localhost callback.
WORKOS_CLIENT_ID=
WORKOS_AUTHKIT_DOMAIN=
WORKOS_API_KEY=
# Enable RBAC only after provisioning the dashboard organization and admin,
# applying the session schema, and verifying the signed token issuer.
WORKOS_RBAC_ENABLED=false
WORKOS_RBAC_ORGANIZATION_ID=
WORKOS_RBAC_ISSUER=
WORKOS_RBAC_PERMISSION=egm:dashboard:admin
# Required for account widgets after verifying the stable owner identity.
WORKOS_WIDGETS_ENABLED=false
WORKOS_OWNER_USER_ID=
# Invitation email is opt-in; use a verified sending domain and restricted key.
INVITATION_EMAIL_ENABLED=false
RESEND_API_KEY=
# Decision mail stays off until the preview is approved. Denial is a second switch.
# Apply egm-cloudflare/decision-email-schema.sql before turning either one on.
DECISION_EMAIL_ENABLED=false
DECISION_DENY_EMAIL_ENABLED=false
# Optional collectors. Leave blank for offline development.
SEMRUSH_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
PARALLEL_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_WEB_PERFORMANCE_API_KEY=
# Build-time browser analytics configuration. Use a public project token, not a personal API key.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
