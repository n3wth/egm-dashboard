{
  "name": "egm-growth",
  "main": "worker.mjs",
  "account_id": "ac23513945eb49f73a89faf1be12384e",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {"bindings": [{"name": "ACCESS_LIVE", "class_name": "AccessLive"}]},
  "migrations": [{"tag": "access-live-v1", "new_sqlite_classes": ["AccessLive"]}],
  "triggers": {"crons": ["*/30 * * * *"]},
  "routes": [{"pattern": "egm.n3wth.com", "custom_domain": true}],
  "assets": {"directory": "assets", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "egm-growth-access", "database_id": "4e4bd12f-afcf-4fda-a875-f40afa765f97"}],
  "vars": {
    "APP_URL": "https://egm.n3wth.com",
    "VIDEO_INITIAL_BACKFILL_LIMIT": "10",
    "OWNER_EMAIL": "oliver@newth.ai",
    "APPROVAL_WEBHOOK_HOSTS": "connectors.api.openai.com",
    "GROK_WEBHOOK_HOSTS": "api2.cursor.sh",
    // Paid collection stops at this instant. This is the only end date. Change this line to extend it.
    "REFRESH_UNTIL": "2026-11-04T06:33:01Z",
    "WORKOS_CLIENT_ID": "client_01M60K01HRESAKEPD135F3KAMM",
    "WORKOS_AUTHKIT_DOMAIN": "https://striking-ripple-85.authkit.app",
    "INVITATION_EMAIL_ENABLED": "true",
    "WORKOS_RBAC_ENABLED": "true",
    "WORKOS_RBAC_ORGANIZATION_ID": "org_01M616GHNTAA6GW7ER7RAXDSR0",
    "WORKOS_RBAC_ISSUER": "https://api.workos.com/user_management/client_01KT21TBYTKHENW4172A587X7Q",
    "WORKOS_RBAC_PERMISSION": "egm:dashboard:admin",
    "WORKOS_WIDGETS_ENABLED": "true",
    // Reuse a successful WorkOS session or admin check for this many milliseconds. 0 disables the cache.
    "WORKOS_CHECK_CACHE_MS": "45000",
    "WORKOS_OWNER_USER_ID": "user_01M5SCP5F3JTK0NFFBMS0NFJAB"
  }
}
